# ---- Required -------------------------------------------------------------

# Base URL of the Prometheus HTTP API. No trailing /api/v1 — just the root.
PROMETHEUS_URL=https://prometheus.internal.example.com

# Bearer token. Sent as `Authorization: Bearer <token>`.
# Leave unset for an unauthenticated Prometheus (e.g. a local one).
PROMETHEUS_TOKEN=

# ---- Optional -------------------------------------------------------------

# Port this app listens on.
PORT=8787

# Milliseconds before a Prometheus request is abandoned. Range queries over
# long windows on a busy server can be slow; raise this if you see timeouts.
PROMETHEUS_TIMEOUT_MS=30000

# Set to 1 to skip TLS verification. Only for self-signed certs on a trusted
# network — it disables the check for the whole process.
PROMETHEUS_INSECURE=0

# Extra headers as JSON, for proxies that need them (tenant IDs, CF Access, etc).
# Example: {"X-Scope-OrgID":"team-payments"}
PROMETHEUS_HEADERS=

# How long the metric catalog is cached, in seconds. The catalog is the list of
# every metric name plus its HELP/TYPE — it changes rarely and is expensive to
# fetch, so it is cached rather than re-read on every wizard step.
CATALOG_TTL_SECONDS=300
