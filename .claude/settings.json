{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node scripts/*)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git restore*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(git config*)",
      "Bash(git count-objects*)",

      "Bash(docker *)",

      "Bash(curl *)",

      "Bash(lsof *)",
      "Bash(ps *)",
      "Bash(pkill *)",
      "Bash(kill *)",
      "Bash(python3 *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",

      "Read(//tmp/**)",
      "Read(//private/tmp/**)"
    ]
  }
}
