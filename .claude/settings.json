{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node scripts/*)",

      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git restore*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(git config*)",
      "Bash(git count-objects*)",

      "Bash(docker *)",

      "Bash(curl -s localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s -o /dev/null*)",

      "Bash(lsof *)",
      "Bash(ps *)",
      "Bash(pkill -f *)",
      "Bash(python3 *)",

      "Read(//tmp/**)",
      "Read(//private/tmp/**)"
    ]
  }
}
